---
import { profile } from "@/data/cv";
---

<!-- About Section -->
<section id="about" class="py-16 md:py-24 reveal">
  <div class="space-y-12">
    <!-- Section Header -->
    <div class="flex flex-col items-start gap-3">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/5 text-xs font-semibold text-primary uppercase tracking-wider"
      >
        <i class="fa-solid fa-user text-xs"></i>
        <span>About Me</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground"
      >
        Bridging Systems Engineering & <span
          class="bg-linear-to-r from-primary via-secondary to-primary bg-clip-text text-transparent"
          >Tech Education</span
        >
      </h2>
      <p
        class="text-muted-foreground text-base sm:text-lg max-w-2xl leading-relaxed"
      >
        A dedicated software developer and educator based in {profile.location},
        focused on building robust desktop and web systems while inspiring the
        next generation of technologists.
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Story / Narrative (7 cols) -->
      <div class="lg:col-span-7 space-y-6 text-foreground/90 leading-relaxed">
        <div
          class="rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-6 sm:p-8 space-y-4 shadow-sm"
        >
          <h3
            class="text-xl font-bold text-foreground flex items-center gap-2.5"
          >
            <i class="fa-solid fa-compass text-primary text-base"></i>
            <span>My Journey & Focus</span>
          </h3>
          <p class="text-sm sm:text-base text-muted-foreground">
            My path in technology is centered on two interconnected pillars: <strong
              class="text-foreground">software engineering</strong
            > and <strong class="text-foreground">practical education</strong>.
            Through architecting desktop application alongside structured
            relational databases, I build software that solves tangible
            administrative and institutional problems.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground">
            In parallel to engineering, I volunteer as a <strong
              class="text-foreground">Computer Science Teacher</strong
            > at Don Bosco High School of Poipet. I design hands-on programming labs,
            guiding students from their very first algorithms to writing clean code
            and fostering computational problem-solving workflows.
          </p>
          <p class="text-sm sm:text-base text-muted-foreground">
            Whether building operational software, administering community
            digital platforms, or mentoring students in the lab, I bring
            attention to detail, structured thinking, and a strong sense of
            responsibility.
          </p>
        </div>

        <!-- Highlight Pillars -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div
            class="rounded-xl border border-border/70 bg-card/40 backdrop-blur-sm p-4 flex items-start gap-3.5"
          >
            <div
              class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary shrink-0"
            >
              <i class="fa-solid fa-chalkboard-user text-sm"></i>
            </div>
            <div class="space-y-1">
              <h4 class="text-sm font-semibold text-foreground">
                Educator & Mentor
              </h4>
              <p class="text-xs text-muted-foreground leading-snug">
                Instructing CS logic, fundamental algorithms, and digital
                literacy to high school students.
              </p>
            </div>
          </div>

          <div
            class="rounded-xl border border-border/70 bg-card/40 backdrop-blur-sm p-4 flex items-start gap-3.5"
          >
            <div
              class="w-10 h-10 rounded-lg bg-secondary/15 border border-secondary/25 flex items-center justify-center text-secondary shrink-0"
            >
              <i class="fa-solid fa-laptop-code text-sm"></i>
            </div>
            <div class="space-y-1">
              <h4 class="text-sm font-semibold text-foreground">
                Systems Developer
              </h4>
              <p class="text-xs text-muted-foreground leading-snug">
                Engineering dependable desktop apps and web solutions with
                C#/.NET, XAML, and SQL databases.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar / Cards (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Quick Info & Location Card -->
        <div
          class="rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-6 space-y-4 shadow-sm"
        >
          <h3
            class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
          >
            Personal Snapshot
          </h3>
          <div class="divide-y divide-border/60">
            <div class="py-2.5 flex items-center justify-between text-sm">
              <span
                class="text-muted-foreground flex items-center gap-2 text-xs"
              >
                <i class="fa-solid fa-location-dot text-xs text-primary"></i>
                <span>Location</span>
              </span>
              <span class="font-medium text-foreground text-right text-xs">
                Poipet, Cambodia
              </span>
            </div>
            <div class="py-2.5 flex items-center justify-between text-sm">
              <span
                class="text-muted-foreground flex items-center gap-2 text-xs"
              >
                <i class="fa-solid fa-briefcase text-xs text-primary"></i>
                <span>Status</span>
              </span>
              <span
                class="inline-flex items-center gap-1.5 font-medium text-emerald-500 text-xs"
              >
                <span
                  class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                Open to Opportunities
              </span>
            </div>
            <div class="py-2.5 flex items-center justify-between text-sm">
              <span
                class="text-muted-foreground flex items-center gap-2 text-xs"
              >
                <i class="fa-solid fa-building-columns text-xs text-primary"
                ></i>
                <span>Institution</span>
              </span>
              <span class="font-medium text-foreground text-right text-xs">
                Don Bosco High School
              </span>
            </div>
            <div class="py-2.5 flex items-center justify-between text-sm">
              <span
                class="text-muted-foreground flex items-center gap-2 text-xs"
              >
                <i class="fa-regular fa-envelope text-xs text-primary"></i>
                <span>Email</span>
              </span>
              <a
                href={`mailto:${profile.email}`}
                class="font-medium text-primary hover:underline text-xs truncate max-w-[170px]"
              >
                {profile.email}
              </a>
            </div>
          </div>
        </div>

        <!-- Language Proficiency Card -->
        <div
          class="rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-6 space-y-4 shadow-sm"
        >
          <div class="flex items-center justify-between">
            <h3
              class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"
            >
              Languages
            </h3>
            <i class="fa-solid fa-language text-primary text-base"></i>
          </div>
          <div class="grid grid-cols-2 gap-2.5">
            {
              profile.languages.map((lang) => (
                <div class="rounded-xl border border-border/60 bg-muted/30 p-3 flex flex-col gap-1">
                  <span class="text-xs font-semibold text-foreground flex items-center justify-between">
                    {lang.name}
                    {lang.highlight && (
                      <span class="w-1.5 h-1.5 rounded-full bg-primary" />
                    )}
                  </span>
                  <span class="text-[11px] text-muted-foreground">
                    {lang.level}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
