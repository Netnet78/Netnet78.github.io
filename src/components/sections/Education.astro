---
import { profile } from "@/data/cv";
---

<!-- Education Section -->
<section id="education" class="py-16 md:py-24 reveal">
  <div class="space-y-12">
    <!-- Section Header -->
    <div class="flex flex-col items-start gap-3">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/5 text-xs font-semibold text-primary uppercase tracking-wider"
      >
        <i class="fa-solid fa-graduation-cap text-xs"></i>
        <span>Education</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground"
      >
        Academic Background & <span
          class="bg-linear-to-r from-primary via-secondary to-primary bg-clip-text text-transparent"
          >Studies</span
        >
      </h2>
      <p
        class="text-muted-foreground text-base sm:text-lg max-w-2xl leading-relaxed"
      >
        A chronological summary of my formal education and technical training in computer studies and foundational sciences.
      </p>
    </div>

    <!-- Timeline Container -->
    <div
      class="relative ml-5 sm:ml-7 pl-6 sm:pl-8 border-l-2 border-border/70 space-y-10"
    >
      {
        profile.education.map((edu, index) => {
          const isLatest = index === 0;

          return (
            <div class="relative group">
              <!-- Timeline Node Marker -->
              <div class="absolute top-2 -left-13 flex items-center justify-center">
                <div
                  class={`w-10 h-10 rounded-full border-2 ${
                    isLatest
                      ? "border-primary bg-card text-primary ring-4 ring-primary/15 shadow-sm"
                      : "border-border/80 bg-card text-muted-foreground"
                  } flex items-center justify-center text-sm shadow-sm transition-transform duration-300 group-hover:scale-110`}
                >
                  <i class={edu.icon} />
                </div>
              </div>

              <!-- Education Card -->
              <div class="rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-6 sm:p-7 shadow-sm transition-all duration-300 hover:border-primary/40 hover:shadow-md space-y-4">
                <!-- Header Row: Degree, School, Location, and Period -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-border/60">
                  <div class="space-y-1.5">
                    <h3 class="text-lg sm:text-xl font-bold text-foreground tracking-tight">
                      {edu.degree}
                    </h3>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-medium text-muted-foreground">
                      <div class="flex items-center gap-2">
                        <i class="fa-solid fa-building-columns text-xs text-primary" />
                        <span>{edu.school}</span>
                      </div>
                      {edu.location && (
                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                          <i class="fa-solid fa-location-dot text-[11px] text-primary" />
                          <span>{edu.location}</span>
                        </div>
                      )}
                    </div>
                  </div>

                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary border border-primary/20">
                      <i class="fa-regular fa-calendar text-[11px]" />
                      <span>{edu.period}</span>
                    </span>
                  </div>
                </div>

                <!-- Description -->
                <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
                  {edu.description}
                </p>

                <!-- Competencies / Skill Pills -->
                {edu.skills && edu.skills.length > 0 && (
                  <div class="pt-2 flex flex-wrap items-center gap-1.5">
                    {edu.skills.map((pill) => (
                      <span class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium">
                        {pill}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
