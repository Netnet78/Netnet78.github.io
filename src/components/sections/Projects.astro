---
import { profile } from "@/data/cv";
---

<!-- Projects Section -->
<section id="projects" class="py-16 md:py-24 reveal">
  <div class="space-y-12">
    <!-- Section Header -->
    <div class="flex flex-col items-start gap-3">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/5 text-xs font-semibold text-primary uppercase tracking-wider"
      >
        <i class="fa-solid fa-laptop-code text-xs"></i>
        <span>Featured Projects</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground"
      >
        Crafted Systems & <span
          class="bg-linear-to-r from-primary via-secondary to-primary bg-clip-text text-transparent"
          >Digital Solutions</span
        >
      </h2>
      <p
        class="text-muted-foreground text-base sm:text-lg max-w-2xl leading-relaxed"
      >
        A selection of desktop applications, educational curriculum tools, and multimedia workflows engineered for performance and real-world utility.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        profile.projects.map((project) => (
          <div class="group relative rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-6 sm:p-7 shadow-sm transition-all duration-300 hover:border-primary/50 hover:shadow-xl flex flex-col justify-between overflow-hidden">
            <!-- Background Accent Glow on Hover -->
            <div class="absolute -inset-0.5 rounded-2xl bg-linear-to-b from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />

            <div class="space-y-4 relative z-10">
              <!-- Top Category & Icon Row -->
              <div class="flex items-center justify-between gap-3">
                <span class="text-[11px] font-semibold tracking-wider uppercase px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
                  {project.category}
                </span>

                <div class="w-10 h-10 rounded-xl border border-border/70 bg-card/80 flex items-center justify-center text-primary text-base shadow-2xs group-hover:scale-110 group-hover:border-primary/40 transition-transform duration-300">
                  <i class={project.icon} />
                </div>
              </div>

              <!-- Title & Description -->
              <div class="space-y-2">
                <h3 class="text-xl font-bold text-foreground tracking-tight group-hover:text-primary transition-colors">
                  {project.title}
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  {project.description}
                </p>
              </div>
            </div>

            <!-- Skill Tags Footer -->
            <div class="pt-6 relative z-10 space-y-4">
              <div class="h-px w-full bg-border/60" />
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
