---
import { profile } from "@/data/cv";
---

<!-- Skills Section -->
<section id="skills" class="py-16 md:py-24 reveal">
  <div class="space-y-12">
    <!-- Section Header -->
    <div class="flex flex-col items-start gap-3">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/5 text-xs font-semibold text-primary uppercase tracking-wider"
      >
        <i class="fa-solid fa-layer-group text-xs"></i>
        <span>Technical Proficiency</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground"
      >
        Skills, Capabilities & <span
          class="bg-linear-to-r from-primary via-secondary to-primary bg-clip-text text-transparent"
          >Tooling</span
        >
      </h2>
      <p
        class="text-muted-foreground text-base sm:text-lg max-w-2xl leading-relaxed"
      >
        A structured breakdown of my engineering stack, multimedia design competencies, and professional collaboration capabilities.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        profile.skills.map((skillGroup) => (
          <div class="group relative rounded-2xl border border-border/80 bg-card/60 backdrop-blur-md p-6 sm:p-7 shadow-sm transition-all duration-300 hover:border-primary/50 hover:shadow-xl flex flex-col justify-between overflow-hidden">
            <!-- Background Accent Glow on Hover -->
            <div class="absolute -inset-0.5 rounded-2xl bg-linear-to-b from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />

            <div class="space-y-6 relative z-10">
              <!-- Category Header with Icon -->
              <div class="space-y-3">
                <div class="w-12 h-12 rounded-xl border border-border/70 bg-card/80 flex items-center justify-center text-primary text-xl shadow-2xs group-hover:scale-110 group-hover:border-primary/40 transition-transform duration-300">
                  <i class={skillGroup.faIcon} />
                </div>
                <h3 class="text-xl font-bold text-foreground tracking-tight group-hover:text-primary transition-colors">
                  {skillGroup.category}
                </h3>
              </div>

              <!-- Skill Pills List -->
              <div class="flex flex-wrap gap-2 pt-1">
                {skillGroup.items.map((item) => (
                  <span class="text-xs px-3 py-1.5 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium transition-colors hover:bg-secondary/25">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <!-- Footer Meta Indicator -->
            <div class="pt-6 relative z-10">
              <div class="h-px w-full bg-border/60 mb-3" />
              <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>{skillGroup.items.length} competencies</span>
                <i class="fa-solid fa-arrow-trend-up text-primary text-[11px] opacity-70 group-hover:opacity-100 transition-opacity" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
