---
import { Image } from "astro:assets";
import { profile } from "@/data/cv";
---

<!-- Hero Section -->
<section id="hero" class="relative pt-6 pb-16 md:py-20 reveal">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <!-- Left Content Column -->
    <div class="lg:col-span-7 flex flex-col items-start gap-6">
      <!-- Status Pill -->
      <div
        class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-primary/20 bg-primary/5 text-xs font-medium text-foreground backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
          ></span>
        </span>
        <span>Available for hire</span>
      </div>

      <!-- Headline -->
      <div class="space-y-2">
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-[1.15]"
        >
          Hello! I am a<br />
          <span
            id="typewriter-text"
            class="bg-linear-to-r from-primary via-secondary to-primary bg-clip-text text-transparent"
            >Teacher</span
          ><span
            class="inline-block w-0.75 sm:w-1 h-[0.85em] bg-primary ml-1.5 align-baseline animate-pulse rounded-full"
            aria-hidden="true"></span>
        </h1>
        <p
          class="text-base sm:text-lg text-muted-foreground leading-relaxed pt-2 max-w-xl"
        >
          Hi, I'm <strong class="text-foreground font-semibold"
            >{profile.name}</strong
          > — a practical software developer with hands-on experience across desktop
          architectures (C#, XAML, WPF), relational database design, and full-stack
          web technologies. Alongside development, I actively teach Computer Science
          to students and manage digital communication platforms.
        </p>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/#projects"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-primary-foreground font-medium text-sm transition-all hover:bg-primary/90 shadow-sm"
        >
          <span>Explore Projects</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
        <a
          href="/#contact"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg border border-border bg-card/60 hover:bg-muted font-medium text-sm text-foreground transition-all"
        >
          <i class="fa-regular fa-envelope text-xs"></i>
          <span>Get in Touch</span>
        </a>
      </div>
    </div>

    <!-- Right Visual Card Column -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end">
      <div class="relative w-full max-w-sm perspective-[1000px] group">
        <!-- Background Glow Effect -->
        <div
          class="absolute -inset-1 rounded-3xl bg-linear-to-tr from-primary/30 via-secondary/20 to-transparent blur-2xl -z-10 opacity-70 transition-all duration-500 group-hover:scale-105 group-hover:opacity-90"
        >
        </div>

        <!-- Profile Card -->
        <div
          class="relative rounded-2xl border border-border/80 bg-card/80 backdrop-blur-md p-5 shadow-xl flex flex-col gap-5 overflow-hidden transition-all duration-500 ease-out transform-gpu group-hover:transform-[rotateX(8deg)_rotateY(-12deg)_translateZ(20px)] group-hover:shadow-2xl"
        >
          <!-- Image Frame -->
          <div
            class="relative rounded-xl overflow-hidden aspect-square border border-border/60 bg-muted"
          >
            <Image
              width={400}
              height={400}
              src="/images/square-profile.jpg"
              alt={profile.name}
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent pointer-events-none h-full w-full"
            >
            </div>
            <div
              class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs text-white/90"
            >
              <span
                class="font-medium bg-black/40 backdrop-blur-sm px-2.5 py-1 rounded-md border border-white/10"
              >
                Sy Sophaneth
              </span>
              <span
                class="font-medium bg-primary/80 backdrop-blur-sm px-2.5 py-1 rounded-md border border-white/10"
              >
                Educator & Dev
              </span>
            </div>
          </div>

          <!-- Tech Stack Tags Snapshot -->
          <div class="flex flex-col gap-2">
            <span
              class="text-xs font-semibold tracking-wider text-muted-foreground uppercase"
            >
              Core Focus & Stack
            </span>
            <div class="flex flex-wrap gap-1.5">
              <span
                class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium"
              >
                C# / .NET
              </span>
              <span
                class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium"
              >
                XAML & WPF
              </span>
              <span
                class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium"
              >
                Full Stack Web
              </span>
              <span
                class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium"
              >
                Relational DBs
              </span>
              <span
                class="text-xs px-2.5 py-1 rounded-md bg-secondary/15 text-secondary border border-secondary/25 font-medium"
              >
                Computer Science
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let typewriterTimeout: number | undefined;

  function initTypewriter() {
    if (typewriterTimeout) {
      clearTimeout(typewriterTimeout);
      typewriterTimeout = undefined;
    }

    const target = document.getElementById("typewriter-text");
    if (!target) return;

    const words = ["Teacher", "Developer", "Designer"];
    let wordIndex = 0;
    let charIndex = target.textContent?.trim().length || words[0].length;
    let isDeleting = true;

    function step() {
      const currentWord = words[wordIndex];

      if (!target) return;

      if (isDeleting) {
        charIndex--;
        target.textContent = currentWord.substring(0, charIndex);
      } else {
        charIndex++;
        target.textContent = currentWord.substring(0, charIndex);
      }

      let speed = isDeleting ? 60 : 120;

      if (!isDeleting && charIndex === currentWord.length) {
        // Finished typing word, pause before erasing
        isDeleting = true;
        speed = 1800;
      } else if (isDeleting && charIndex === 0) {
        // Finished erasing, move to next word
        isDeleting = false;
        wordIndex = (wordIndex + 1) % words.length;
        speed = 350;
      }

      typewriterTimeout = window.setTimeout(step, speed);
    }

    // Pause briefly on initial word before starting animation
    typewriterTimeout = window.setTimeout(step, 1600);
  }

  document.addEventListener("astro:page-load", initTypewriter);
</script>
